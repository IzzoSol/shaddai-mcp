# SHADDAI MCP — API keys. Copy this file to .env and add ONE key.
# rag_ask / run_agent try providers in this order until one succeeds:
#   Groq → OpenRouter → Gemini → Anthropic → OpenAI → local Ollama (last resort).

# FREE + FASTEST — https://console.groq.com
GROQ_API_KEY=

# Optional alternates:
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — local fallback only when NO cloud key is set (needs Ollama installed):
# DEFAULT_OLLAMA_MODEL=phi4-mini
# OLLAMA_API_URL=http://localhost:11434
# OLLAMA_TIMEOUT_MS=120000
